# Copy to .env and fill in values. Do not commit .env.

# Database (optional; defaults to SQLite if unset)
# DATABASE_URL=sqlite+aiosqlite:///./orbit.db
# For Docker/Postgres: postgresql+asyncpg://orbit:orbit@db:5432/orbit

# Auth (change in production)
SECRET_KEY=orbit-demo-secret-change-in-production

# AI (optional; mock mode used if unset or MOCK_AI=true)
# OPENAI_API_KEY=sk-...
MOCK_AI=true

# CORS (optional)
# CORS_ORIGINS=["http://localhost:3000"]
